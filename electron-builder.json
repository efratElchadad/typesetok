{
  "appId": "com.typesetok.desktop",
  "productName": "TypesetOK",
  "directories": { "app": "desktop-stage", "output": "release" },
  "files": ["package.json", "LICENSE.md", "packages/**/*"],
  "asar": true,
  "npmRebuild": false,
  "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
  "nsis": {
    "artifactName": "TypesetOK-${version}-Windows-x64-Setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  }
}
